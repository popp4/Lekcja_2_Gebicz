
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Losowanie kostek"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ile kostek wylosować?"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/editTextLiczbaKostek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Wpisz ilość"
            android:inputType="number"
            android:maxLength="3"
            android:text="5" />

        <Button
            android:id="@+id/buttonLosuj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOSUJ KOSTKI"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wynik losowania:"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <GridLayout
            android:id="@+id/gridKostki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:layout_gravity="center"
            android:gravity="center"
            android:useDefaultMargins="true"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lista wyrzuconych oczek:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/textViewWyniki"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tutaj pojawią się wyniki"
            android:textSize="20sp"
            android:gravity="center"
            android:padding="12dp" />

        <Button
            android:id="@+id/buttonRosnaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORTUJ ROSNĄCO"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/buttonMalejaco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORTUJ MALEJĄCO"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
